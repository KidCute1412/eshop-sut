        </HTTPSamplerProxy>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="3. POST /api/cart (Spike)" enabled="true">
          <stringProp name="HTTPSampler.domain">localhost</stringProp>
